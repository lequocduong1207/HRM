# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/hrm_db

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL
CLIENT_URL=http://localhost:5173

# Logging
# Set to 'true' to show full stack traces in development mode
# WARNING: Never enable in production!
SHOW_STACK_TRACE=false

# Security - Rate Limiting
# Auth endpoints (login, register)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# General API endpoints
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# Write operations (POST, PUT, DELETE)
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX_REQUESTS=30
